# p1228-java 環境変数サンプル。.env にコピーして実値を入れること。
# Token と Secret の実値は絶対にコミットしないこと。

# ===== 1. BOT Token (3体分・すべて異なる値) =====
P1228_GENERAL_BOT_TOKEN=REPLACE_ME
P1228_READ_ALOUD_A_BOT_TOKEN=REPLACE_ME
P1228_READ_ALOUD_B_BOT_TOKEN=REPLACE_ME

# ===== 2. Application ID (3体分・すべて異なる値) =====
P1228_GENERAL_APPLICATION_ID=REPLACE_ME
P1228_READ_ALOUD_A_APPLICATION_ID=REPLACE_ME
P1228_READ_ALOUD_B_APPLICATION_ID=REPLACE_ME

# ===== 3. Worker Secret (単一JVM構成でも原本互換のため検証する。各32文字以上・すべて異なる値) =====
P1228_GENERAL_WORKER_SECRET=REPLACE_ME
P1228_READ_ALOUD_A_WORKER_SECRET=REPLACE_ME
P1228_READ_ALOUD_B_WORKER_SECRET=REPLACE_ME

# ===== 4. 任意: VOICEVOX ENGINE のURL (config.json の voicevox_base_url でも指定可) =====
# P1228_AUDIO_ENGINE_URL=http://127.0.0.1:50021
